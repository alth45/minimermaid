{
  "name": "minimermaid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MiniMermaid — ubah teks menjadi diagram flowchart SVG. Konversi TypeScript dari versi HTML tunggal.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
