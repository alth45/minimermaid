{
  "name": "minimermaid",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/minimermaid.umd.js",
  "module": "./dist/minimermaid.es.js",
  "types": "./src/lib.ts",
  "exports": {
    ".": {
      "types": "./src/lib.ts",
      "import": "./dist/minimermaid.es.js",
      "require": "./dist/minimermaid.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "dependencies": {
    "lucide": "^1.63.0",
    "lucide-react": "^1.63.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
